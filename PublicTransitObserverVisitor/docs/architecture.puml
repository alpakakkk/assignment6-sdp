@startuml
skinparam classAttributeIconSize 0
interface "Subject<E>" as Subject
interface "Observer<E>" as Observer
class EventSource
class ArrivalFeed
class TicketFeed
class RouteAggregator
class InspectionListener
interface TransitNode
interface ContainerNode
interface "TransitVisitor<R>" as Visitor
class TransitNetwork
class TransitRoute
class TransitStop
class Bus
class Tram
class Station
class TicketMachine
class FuelVisitor
class RevenueVisitor
class InventoryVisitor
class AccessibilityVisitor
class JsonExportVisitor
Subject <|.. EventSource
Subject <|.. ArrivalFeed
Subject <|.. TicketFeed
Subject <|.. RouteAggregator
Observer <|.. RouteAggregator
Observer <|.. InspectionListener
